APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://mangastore_app:CHANGE_THIS_STRONG_DB_PASSWORD@127.0.0.1:5432/mangastore_db
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://192.168.100.10,http://localhost,http://localhost:5173
UPLOAD_DIR=/opt/mangastore-vps/uploads
APP_BASE_URL=http://192.168.100.10

# Optional AI Chatbot (Groq) - leave empty to use local Vietnamese rule engine
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional MoMo Payment Gateway
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# Optional SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# Optional Google reCAPTCHA v2 & OAuth2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
